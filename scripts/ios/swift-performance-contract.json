{
  "schemaVersion": 1,
  "kind": "lyb.swift-performance-contract",
  "measurementPolicy": "Budgets below are proposed targets, not measured gates. Synchronous UI work stays under 5ms where feasible, event-to-feedback p95 stays under 100ms, and the hitch ceiling is 10ms/s. Current numbers stay blank until a physical-device receipt exists. CI treats a missing device receipt as unverified.",
  "signpostBuild": {
    "compilationCondition": "LYB_PERF_TRACE",
    "optIn": true,
    "appStoreRelease": "excluded"
  },
  "deviceReceipt": {
    "path": "scripts/ios/swift-performance-device-receipt.json",
    "missingStatus": "unverified",
    "physicalPassRequires": [
      "device",
      "os",
      "buildSha",
      "thermalState",
      "refreshRateHz",
      "fixtureId"
    ],
    "refreshRateHz": [60, 120]
  },
