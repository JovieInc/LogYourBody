{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "node -v && corepack pnpm --version && cd ../.. && corepack pnpm install --frozen-lockfile && cd apps/web",
  "buildCommand": "cd ../.. && corepack pnpm turbo run build --filter=logyourbody...",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/avatars/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-deployment-id",
          "value": "$VERCEL_DEPLOYMENT_ID"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/(?!api(?:/|$)|_next(?:/|$)|\\.well-known(?:/|$)|signin(?:/|$)|signup(?:/|$)|login(?:/|$)|dashboard(?:/|$)|log(?:/|$)|onboarding(?:/|$)|settings(?:/|$)|photos(?:/|$)|steps(?:/|$)|import(?:/|$)|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$).*",
      "methods": [
        "GET",
        "HEAD"
      ],
      "missing": [
        {
          "type": "header",
          "key": "rsc"
        },
        {
          "type": "header",
          "key": "next-router-prefetch"
        }
      ],
      "continue": true,
      "transforms": [
        {
          "type": "response.headers",
          "op": "append",
          "target": {
            "key": "Vary"
          },
          "args": "Accept"
        }
      ]
    }
  ]
}
