{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/codex-setup.sh\" --codex-hook",
            "timeout": 600,
            "statusMessage": "Preparing Log Your Body dependencies"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/codex-cleanup.sh\" --codex-hook",
            "timeout": 5,
            "statusMessage": "Preserving Log Your Body worktree"
          }
        ]
      }
    ]
  }
}
