{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "corepack pnpm turbo run build --filter=logyourbody...",
  "outputDirectory": "apps/web/.next",
  "installCommand": "node -v && corepack pnpm --version && corepack pnpm install --frozen-lockfile",
  "devCommand": "pnpm --filter apps/web dev",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/internal/chat-retention",
      "schedule": "17 4 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "github": {
    "silent": true
  },
  "routes": [
    {
      "src": "^/(?!api(?:/|$)|_next(?:/|$)|\\.well-known(?:/|$)|signin(?:/|$)|signup(?:/|$)|login(?:/|$)|dashboard(?:/|$)|log(?:/|$)|onboarding(?:/|$)|settings(?:/|$)|photos(?:/|$)|steps(?:/|$)|import(?:/|$)|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$).*",
      "methods": ["GET", "HEAD"],
      "missing": [
        {
          "type": "header",
          "key": "rsc"
        },
        {
          "type": "header",
          "key": "next-router-prefetch"
        }
      ],
      "continue": true,
      "transforms": [
        {
          "type": "response.headers",
          "op": "append",
          "target": {
            "key": "Vary"
          },
          "args": "Accept"
        }
      ]
    }
  ]
}
