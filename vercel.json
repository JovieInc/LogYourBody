{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "corepack pnpm turbo run build --filter=logyourbody...",
  "outputDirectory": "apps/web/.next",
  "installCommand": "node -v && corepack pnpm --version && corepack pnpm install --frozen-lockfile",
  "devCommand": "pnpm --filter apps/web dev",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/internal/chat-retention",
      "schedule": "17 4 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "github": {
    "silent": true
  }
}
