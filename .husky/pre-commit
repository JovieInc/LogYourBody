echo "Husky: running pre-commit (lint-staged)..."

node scripts/pre-commit-lint.mjs || exit $?

# Validate staged immutable Jovie imports after all normal lint/format tasks.
node scripts/check-jovie-imports.mjs --staged

# Classify a staged correction ledger so a merge cannot commit missing level or ruleId.
if git diff --cached --name-only --diff-filter=ACMR | grep -qx 'packages/shared-lib/corrections.json'; then
  node scripts/correction-classifier.mjs || exit $?
  git add -- packages/shared-lib/corrections.json
fi

# Rebuild a conflicted source map from stage-zero inputs before the merge check.
# The ledger verifier rejects every other unmerged path, including this projection.
python3 scripts/resolve-repository-docs.py --staged

# Verify the staged merge, including when the ledger has no diff against HEAD.
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  node scripts/correction-classifier.mjs --check-merge . || exit $?
fi
